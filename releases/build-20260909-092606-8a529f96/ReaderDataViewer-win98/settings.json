// Reader Data Viewer 設定（JSONC）。使い始めはREADME.mdの最小例から。
// // と /* ... */ のコメント、末尾カンマを使用可。UTF-8で保存。
// K番号はREADMEの全項目索引と対応します。コメントのための追加キーは書きません。
// paths/search/watchを画面から保存すると、その領域内のコメントは再生成で消えます。
// その他のコメントは残ります。設定を委託するときは本ファイルの控えとREADMEを渡してください。
// 通常は再起動して設定を適用。共有台帳の列・キー・保存状態を変える場合は全PCの移行を揃えます。
// 表別のencoding、複合key、aggregateの例と3段の検査はREADMEに載っています。
// 提出前に設定作者が -ValidateOnly と -RunUpdate を実行し、結果まで照合します（README冒頭）。
// 表IDはtablesのlabel、列と中間結果名はdata.labels、台帳名はdata.labels.ledgerへ。表IDをlabelsに重ねません。
// CSVの列不足行と空行は除外し、warningsに件数を出します。不足セルは補完しません。列超過・不正な引用符は拒否します。
// CSV/XLSXの重複見出しは、キー・型・全ジョブ・台帳から参照しない同名の全列だけを除外して件数を出します。
// 参照する重複名は、片方の全セルが空でも拒否します。labelsやselectでは読み分けられません（READMEの入力境界）。
// 計算結果・集計結果は作った名前のまま台帳へ保存できます（calculateのcolumn、aggregateのas、selectのasを <結果名>.<列名> でsourceへ）。README「計算結果を台帳へ保存する」。
// 台帳のidentityには集計後のグループ列も使えます。見出しの前に表題行があるCSV/XLSXは tables.<ID>.headerRow に見出しの行番号。XLSXの日付セルは types の date 宣言で書式の文字列へ変換します。
// タブ区切り（Excelの「Unicode テキスト」）は tables.<ID>.delimiter に "tab"。コードを名前に置き換える等の条件つきの置き換えは extract の where と update の set の組合せ（README「コード表がファイルに無いとき」）。
{
  // [K001] schema — 設定形式の版。必須で3。この数字は調整しません。
  "schema": 3,
  // [K002] paths — 配置を決める領域。全体を省略すると入力data、台帳data/ReaderDataViewer-Ledger.xlsx、ログdata/ReaderDataViewer.log。変更は再起動後。
  "paths": {
    // [K003] paths.dataDir — 入力フォルダー。相対パスはアプリ一式のフォルダーが基準。入力のfileはこの中を探します。省略data。
    "dataDir": "data",
    // [K004] paths.ledger — 複数PCで共有する1本の.xlsx。相対パスはアプリ基準。入力・ログと同じファイルにはできません。省略data/ReaderDataViewer-Ledger.xlsx。
    "ledger": "data/ReaderDataViewer-Ledger.xlsx",
    // [K005] paths.log — このPCの実行ログ。相対パスはアプリ基準。共有台帳と分け、PCごとに別の場所へ。省略data/ReaderDataViewer.log。
    "log": "data/ReaderDataViewer.log"
  },
  // [K006] search — 検索入力の形式と候補数。テーブルのキー検証とは別で、設定画面の保存後から効きます。
  "search": {
    // [K007] search.pattern — 入力全体に一致させる正規表現。省略は数字8桁。英字等を使う入力なら例 [A-Z0-9-]+ へ。台帳の検索対象列はdata.ledger.search.columns。
    "pattern": "^[0-9]{8}$",
    // [K008] search.candidateRowsShown — 候補一覧へ載せる上限1～1000、省略100。小さくすると一覧から選べる行も減るので、検索条件を絞れることを確認。
    "candidateRowsShown": 100
  },
  // [K009] watch — 外部ウィンドウの値を監視して検索する設定。省略すると監視対象なし。CSV到着の監視ではありません。
  "watch": {
    // [K010] watch.pollMs — 値を読みに行く間隔、5～5000ms、省略40。短くすると反応が速くなり対象アプリへの問い合わせが増えます。
    "pollMs": 40,
    // [K011] watch.stableMs — 値が変わらず続いたら検索へ渡すまでの時間、0～60000ms、省略120。短すぎると入力途中の値を拾います。
    "stableMs": 120,
    // [K012] watch.rebindMs — 未接続の窓を探し直す間隔、50～60000ms、省略400。長くすると窓を開いた後の接続が遅れます。
    "rebindMs": 400,
    // [K013] watch.preferFocusedWindow — 一致する窓が複数あるとき前面を優先するか。省略true。別窓を拾わないようwindowも絞ってください。
    "preferFocusedWindow": true,
    // [K014] watch.targets — 監視先の配列。複数指定可、[]または省略なら監視しません。各対象はwindow→pathの順→fieldをたどります。
    "targets": [
      {
        // [K015] watch.targets[0].enabled — この監視先を使うか。falseでも定義は保存されます。
        "enabled": true,
        // [K016] watch.targets[0].name — 監視先を人が見分ける表示名。窓を探す条件はwindowの中へ。
        "name": "メモ帳",
        // [K017] watch.targets[0].window — 対象のトップレベル窓を絞る条件。別のアプリを拾わないようprocessName等を指定。
        "window": {
          // [K018] watch.targets[0].window.className — UI Automationが公開するクラス名。省略ならこの属性で絞りません。
          "className": "Progman",
          // [K019] watch.targets[0].window.processName — 対象プロセス名、.exeなし。省略ならこの属性で絞りません。
          "processName": "explorer",
          // [K020] watch.targets[0].window.scope — 互換項目。トップレベルの窓だけを探すため、この位置のscopeは動作に影響しません。省略可。path/fieldのscopeは有効。
          "scope": "children"
        },
        // [K021] watch.targets[0].path — 窓から対象欄の親までの経路。[]ならwindowから直接fieldを探します。
        "path": [],
        // [K022] watch.targets[0].field — 値を読む対象欄の条件。設定画面の選択機能で実際の属性を取得できます。
        "field": {
          // [K023] watch.targets[0].field.automationId — UI Automationの識別子。省略ならこの属性で絞りません。
          "automationId": "1",
          // [K024] watch.targets[0].field.controlTypes — UIAの種類、例Edit/Document/List。[]または省略なら種類を限定しません。
          "controlTypes": ["List"],
          // [K025] watch.targets[0].field.scope — descendants（省略時）は子孫全部、childrenは直接の子だけ。深い欄をchildrenにすると見つかりません。
          "scope": "descendants"
        },
        // [K026] watch.targets[0].read — valueはValuePattern、textはTextPattern、nameは表示名を読みます。対象欄が提供する方式を選択。
        "read": "name"
      }
    ]
  },
  // [K027] jobs — 処理時間の監視と共有ファイルの再確認間隔。単位ms。OSのI/Oを強制終了する設定ではありません。省略可。
  "jobs": {
    // [K028] jobs.checkTimeoutMs — 更新確認が遅れたと判定する時間、1000～3600000ms、省略180000。完了前に結果を成功扱いしません。
    "checkTimeoutMs": 180000,
    // [K029] jobs.searchTimeoutMs — 検索が遅れたと判定する時間、1000～3600000ms、省略30000。遅れた検索結果の採用を防ぐための期限。
    "searchTimeoutMs": 30000,
    // [K030] jobs.saveTimeoutMs — 保存が遅れたと判定する時間、1000～3600000ms、省略60000。期限で保存済みとは決めず、実際の完了を待ちます。
    "saveTimeoutMs": 60000,
    // [K031] jobs.markOverdueMs — 保存待ちの長期化を知らせる時間、1000～3600000ms、省略180000。過ぎても未確定の書込みがある間は終了を保留します。
    "markOverdueMs": 180000,
    // [K032] jobs.pumpMs — 画面側の処理状況確認間隔、100～60000ms、省略1000。長いと完了や遅延の表示が遅れます。
    "pumpMs": 1000,
    // [K033] jobs.lockRetryMs — 共有ロック取得を再試行する間隔、50～5000ms、省略250。短いと共有先へのアクセスが増えます。
    "lockRetryMs": 250,
    // [K034] jobs.lockStaleMs — 古いロックか調べる経過時間、60000～86400000ms、省略600000。生きている書込みを時刻だけで解除する設定ではありません。
    "lockStaleMs": 600000,
    // [K035] jobs.markerPollMs — 他PCの更新通知を確認する間隔、500～60000ms、省略3000。長いと最新台帳への切替に気づくのが遅れます。
    "markerPollMs": 3000
  },
  // [K036] data — 入力表と操作順、台帳の列を定義します。画面の判定や作業状態とは別の領域です。必須。
  "data": {
    // [K037] data.encoding — CSVの既定文字コード、省略utf-8。各tables.<ID>.encodingで上書き可。BOMは自動切替ではなく一致確認に使います。XLSXには適用しません。
    "encoding": "utf-8",
    // [K038] data.tables — 入力表を短いIDで登録。1表以上必須。IDにドットや空白は使わず、ledgerは予約名。ここに登録した全表を起動時に確認します。
    "tables": {
      // [K039] data.tables.A — この入力表の定義。fileは入力元、keyは一意性を確かめる列。encodingを追加するとこの表だけ文字コードを上書きでき、見出しが1行目でなければheaderRowに見出しの行番号を書きます。
      "A": {
        // [K040] data.tables.A.label — 表の画面向け名。省略すると表ID。data.labelsに同じ表IDを重ねて書けません（省略時も不可）。列名や結合条件は変わりません。
        "label": "表A",
        // [K041] data.tables.A.file — 入力CSVまたはXLSXのファイル名、必須。相対名はpaths.dataDir基準、絶対パスも可。
        "file": "tableA.csv",
        // [K042] data.tables.A.key — 一意な行を識別する列名、必須。複数列なら ["id","part"] の配列。組合せ全体で重複判定し、各列へkeyValidationが適用されます。
        "key": "key1"
      },
      // [K043] data.tables.B — この入力表の定義。fileは入力元、keyは一意性を確かめる列。encodingを追加するとこの表だけ文字コードを上書きでき、見出しが1行目でなければheaderRowに見出しの行番号を書きます。
      "B": {
        // [K044] data.tables.B.label — 表の画面向け名。省略すると表ID。data.labelsに同じ表IDを重ねて書けません（省略時も不可）。列名や結合条件は変わりません。
        "label": "表B",
        // [K045] data.tables.B.file — 入力CSVまたはXLSXのファイル名、必須。相対名はpaths.dataDir基準、絶対パスも可。
        "file": "tableB.csv",
        // [K046] data.tables.B.key — 一意な行を識別する列名、必須。複数列なら ["id","part"] の配列。組合せ全体で重複判定し、各列へkeyValidationが適用されます。
        "key": "key2",
        // [K047] data.tables.B.keyValidation — キーの検証規則。省略はASCII・列ごとの固定長・内容が違う重複をエラー・空キーは除外。文字列を整形して別のキーを作る指定ではありません。
        "keyValidation": {
          // [K048] data.tables.B.keyValidation.empty — skip（省略時）は空キーを含む行を除外して件数を通知、errorはそのファイルと行・列を示して停止。複合キーではどれか1列が空なら対象。
          "empty": "skip"
        }
      },
      // [K049] data.tables.C — この入力表の定義。fileは入力元、keyは一意性を確かめる列。encodingを追加するとこの表だけ文字コードを上書きでき、見出しが1行目でなければheaderRowに見出しの行番号を書きます。
      "C": {
        // [K050] data.tables.C.label — 表の画面向け名。省略すると表ID。data.labelsに同じ表IDを重ねて書けません（省略時も不可）。列名や結合条件は変わりません。
        "label": "表C",
        // [K051] data.tables.C.file — 入力CSVまたはXLSXのファイル名、必須。相対名はpaths.dataDir基準、絶対パスも可。
        "file": "tableC.csv",
        // [K052] data.tables.C.key — 一意な行を識別する列名、必須。複数列なら ["id","part"] の配列。組合せ全体で重複判定し、各列へkeyValidationが適用されます。
        "key": "key2"
      }
    },
    // [K053] data.types — 数値・日付の型宣言。省略列は文字列、形からの型推測なし。表示だけの書式はscreenのvalue.formatで指定します。calculate/aggregate/selectで作った列にも宣言できます。XLSXの日付セルはdateの宣言でformatの文字列に変換します。
    "types": {
      // [K054] data.types["A.a_date"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "A.a_date": {
        // [K055] data.types["A.a_date"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "date",
        // [K056] data.types["A.a_date"].format — 日付入力の正確な書式。例 yyyyMMdd / yyyy-MM-dd / yyyy/MM/dd / yyyy年M月d日（2026年9月9日）。1列に1書式で、自動判別や複数書式混在ではありません。
        "format": "yyyyMMdd"
      },
      // [K057] data.types["B.b_date"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "B.b_date": {
        // [K058] data.types["B.b_date"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "date",
        // [K059] data.types["B.b_date"].format — 日付入力の正確な書式。例 yyyyMMdd / yyyy-MM-dd / yyyy/MM/dd / yyyy年M月d日（2026年9月9日）。1列に1書式で、自動判別や複数書式混在ではありません。
        "format": "yyyyMMdd"
      },
      // [K060] data.types["C.c_exp"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "C.c_exp": {
        // [K061] data.types["C.c_exp"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "date",
        // [K062] data.types["C.c_exp"].format — 日付入力の正確な書式。例 yyyyMMdd / yyyy-MM-dd / yyyy/MM/dd / yyyy年M月d日（2026年9月9日）。1列に1書式で、自動判別や複数書式混在ではありません。
        "format": "yyyyMMdd"
      },
      // [K063] data.types["A.a_rate"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "A.a_rate": {
        // [K064] data.types["A.a_rate"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "number"
      },
      // [K065] data.types["A.a_amount"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "A.a_amount": {
        // [K066] data.types["A.a_amount"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "number"
      },
      // [K067] data.types["B.b_qty"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "B.b_qty": {
        // [K068] data.types["B.b_qty"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "number"
      },
      // [K069] data.types["B.b_total"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "B.b_total": {
        // [K070] data.types["B.b_total"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "number"
      },
      // [K071] data.types["C.c_price"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "C.c_price": {
        // [K072] data.types["C.c_price"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "number"
      },
      // [K073] data.types["C.c_stock"] — この実在する入力列の型宣言。ラベルではなく表ID.見出しで指定。番号の先頭ゼロを保つ列はtextまたは省略。
      "C.c_stock": {
        // [K074] data.types["C.c_stock"].type — date / number / text。dateはformat必須。numberは全角数字・¥・桁区切り・括弧マイナスを読めます。空セルは型検証を止めません。XLSXの日付セル（シリアル値）はdate宣言の列だけformatの文字列へ変換します。
        "type": "number"
      }
    },
    // [K075] data.labels — 内部参照から画面向け表示名への対応。手順の出力名、キー、集計列にも必要。表自体のラベルはtables側に書きます。
    "labels": {
      // [K076] data.labels["B.key1"] — この内部参照を処理内容・出力一覧で見せる名前。変えてもCSVの見出しや値は変わりません。空文字は不可。
      "B.key1": "番号1",
      // [K077] data.labels["B.key2"] — この内部参照を処理内容・出力一覧で見せる名前。変えてもCSVの見出しや値は変わりません。空文字は不可。
      "B.key2": "番号2",
      // [K078] data.labels["B.b_line"] — この内部参照を処理内容・出力一覧で見せる名前。変えてもCSVの見出しや値は変わりません。空文字は不可。
      "B.b_line": "行番号",
      // [K079] data.labels["B.b_ref"] — この内部参照を処理内容・出力一覧で見せる名前。変えてもCSVの見出しや値は変わりません。空文字は不可。
      "B.b_ref": "参照番号",
      // [K080] data.labels["B.b_date"] — この内部参照を処理内容・出力一覧で見せる名前。変えてもCSVの見出しや値は変わりません。空文字は不可。
      "B.b_date": "日付",
      // [K081] data.labels["B.b_qty"] — この内部参照を処理内容・出力一覧で見せる名前。変えてもCSVの見出しや値は変わりません。空文字は不可。
      "B.b_qty": "数量",
      // [K082] data.labels["B.b_unit"] — この内部参照を処理内容・出力一覧で見せる名前。変えてもCSVの見出しや値は変わりません。空文字は不可。
      "B.b_unit": "単位",
