// ============================================================================
// Reader Data Viewer -- settings
//
// This file is the second half of the distribution: ReaderDataViewer.cmd is the
// program, this is everything a site may change. It sits next to the .cmd and
// is read at start-up; the app's 設定 button edits and rewrites it.
//
// Notes
//   - // line comments and /* block comments */ are allowed here.
//   - A missing file is fine: the built-in defaults are exactly what is
//     written below.
//   - A value that is out of range falls back on its own and says so in the
//     log; the rest of the file still applies.
//   - Relative paths are relative to the folder holding the .cmd.
//
// The full description of every member: docs/settings.md
// ============================================================================
{
  "schema": 1,

  "paths": {
    "dataDir": "data",
    "ledger": "ReaderDataViewer-Ledger.xlsx",
    "log": "ReaderDataViewer.log"
  },

  // The number the watcher is looking for. "length" is also the width of the key
  // column in the CSVs, so it takes effect at the NEXT start, together with the
  // data it describes; "digitsOnly" applies as soon as it is saved.
  "key": { "length": 8, "digitsOnly": true },

  "search": { "candidateRowsShown": 10 },

  "jobs": {
    "checkTimeoutMs": 180000,
    "searchTimeoutMs": 30000,
    "saveTimeoutMs": 60000,
    "markOverdueMs": 180000,
    "pumpMs": 1000
  },

  // WHAT TO WATCH.
  //
  // Every enabled target is bound and polled at the same time; whichever
  // confirms a key first drives the search. A target is a path:
  //
  //     window  ->  path[0]  ->  path[1]  ->  field
  //
  // and each step is matched on the properties UI Automation exposes:
  //
  //     automationId   the stable identifier, when the application sets one
  //     className      the window or control class
  //     name           exact text
  //     nameLike       text with * and ? wildcards
  //     processName    the executable's name, without .exe
  //     controlTypes   Edit, Document, DataGrid, Pane, Custom, ...
  //     index          which one to take when several match (0 = the first)
  //     scope          "descendants" (default) or "children"
  //
  // "read" says where the text comes from: "value" (ValuePattern, the usual
  // case), "text" (TextPattern, rich documents) or "name" (the Name property,
  // for read-only labels).
  //
  // The 設定 dialog has a 「画面を調べる」 button that walks the live tree and
  // fills all of this in from the element you pick -- that is far quicker, and
  // far more accurate, than writing it by hand.
  "watch": {
    "pollMs": 40,
    "stableMs": 120,
    "rebindMs": 400,
    "preferFocusedWindow": true,
    "targets": [
      {
        "enabled": true,
        "name": "メモ帳",
        "window": { "className": "Notepad", "scope": "children" },
        "path": [],
        "field": {
          "controlTypes": ["Document", "Edit"],
          "requireValuePattern": true,
          "scope": "descendants"
        },
        "read": "value"
      }

      // A second target, for a line-of-business window. Delete or edit it.
      // ,{
      //   "enabled": false,
      //   "name": "在庫照会",
      //   "window": { "processName": "LobApp", "nameLike": "在庫照会*", "scope": "children" },
      //   "path": [ { "automationId": "tabMain" }, { "automationId": "pnlSearch" } ],
      //   "field": { "automationId": "txtBarcode", "controlTypes": ["Edit"] },
      //   "read": "value"
      // }
    ]
  }
}
